{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cayla-retail-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3010",
        "pnpm",
        "--filter",
        "web",
        "dev"
      ],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "cayla-retail-dev-windows",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "-p",
        "3010"
      ],
      "port": 3010,
      "autoPort": true
    },
    {
      "name": "maquetas",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server ${PORT:-8791} --directory docs/maquetas"
      ],
      "port": 8791,
      "autoPort": true
    },
    {
      "name": "cayla-retail-dev-3070",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3070",
        "pnpm",
        "--filter",
        "web",
        "dev"
      ],
      "port": 3070
    },
    {
      "name": "guias-flujo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "python3 -m http.server ${PORT:-8792} --directory .flujo-de-negocio/guias"
      ],
      "port": 8792,
      "autoPort": true
    }
  ]
}
