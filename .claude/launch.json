{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cayla-retail-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "cayla-retail-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "exec",
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": true
    }
  ]
}
