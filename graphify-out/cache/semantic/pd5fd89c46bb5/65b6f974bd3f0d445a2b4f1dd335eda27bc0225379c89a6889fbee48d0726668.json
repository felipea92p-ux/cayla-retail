{"nodes": [{"id": "docs_datos_modulos_08_facturacion_sunat_series_comprobantes", "label": "series_comprobantes", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Contador de correlativos por sede+tipo; UNIQUE(sede_id,tipo) evita dos series vivas del mismo tipo."}, {"id": "docs_datos_modulos_08_facturacion_sunat_comprobantes", "label": "comprobantes", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documento legal \u00fanico para boleta/factura/NC/ND; unique(tipo,serie,numero) impide correlativos duplicados ante SUNAT."}, {"id": "docs_datos_modulos_08_facturacion_sunat_proformas", "label": "proformas", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cotizaci\u00f3n sin valor legal (Art. 2, RS 007-99/SUNAT); convertirla crea un comprobante nuevo, nunca se promociona con update."}, {"id": "docs_datos_modulos_08_facturacion_sunat_emitir_comprobante", "label": "emitir_comprobante", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No idempotente: sin token, un doble clic quema dos correlativos irreversibles ante SUNAT (hueco grave)."}, {"id": "docs_datos_modulos_08_facturacion_sunat_emitir_nota", "label": "emitir_nota", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C\u00f3digo vivo e inalcanzable: construida y sin pantalla que la llame; motivo declarado texto libre pero transmitido como c\u00f3digo SUNAT."}, {"id": "docs_datos_modulos_08_facturacion_sunat_registrar_serie_comprobante", "label": "registrar_serie_comprobante", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No valida sede: un l\u00edder puede registrar/reapuntar series de cualquier sede."}, {"id": "docs_datos_modulos_08_facturacion_sunat_actualizar_transmision_comprobante", "label": "actualizar_transmision_comprobante", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_datos_modulos_08_facturacion_sunat_anular_comprobante", "label": "anular_comprobante", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Solo L\u00edder de equipo; bloquea la baja de un comprobante con notas vivas colgadas."}, {"id": "docs_datos_modulos_08_facturacion_sunat_crear_proforma", "label": "crear_proforma", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "docs_datos_modulos_08_facturacion_sunat_convertir_proforma_a_comprobante", "label": "convertir_proforma_a_comprobante", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Idempotente por accidente \u00fatil: for update + estado='vigente' evita doble conversi\u00f3n."}, {"id": "docs_datos_modulos_08_facturacion_sunat_fn_reservar_numero_serie", "label": "fn_reservar_numero_serie", "file_type": "code", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Helper interno con select ... for update: resuelve la carrera de dos sedes emitiendo a la vez."}, {"id": "docs_datos_modulos_08_facturacion_sunat_lucode", "label": "Lucode (PSE de SUNAT)", "file_type": "concept", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proveedor de servicios electr\u00f3nicos que transmite el comprobante a SUNAT; CAYLA reserva el n\u00famero, Lucode transmite."}, {"id": "docs_datos_modulos_08_facturacion_sunat_reserva_correlativo_for_update", "label": "Reserva de serie+correlativo (for update)", "file_type": "rationale", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "select ... for update bloquea la fila de series_comprobantes hasta que la transacci\u00f3n termina; el unique(tipo,serie,numero) es el segundo candado si algo se saltara el primero."}, {"id": "docs_datos_modulos_08_facturacion_sunat_entorno_transmision", "label": "Entorno de transmisi\u00f3n (sandbox/producci\u00f3n)", "file_type": "rationale", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ADR-0015: el ambiente viaja pegado al resultado de la llamada a Lucode y no se relee de process.env al guardar, para que el dato no mienta."}, {"id": "docs_datos_modulos_08_facturacion_sunat_anulacion_dos_tiempos", "label": "Anulaci\u00f3n en dos tiempos", "file_type": "rationale", "source_file": "docs/datos/modulos/08-facturacion-sunat.md", "source_location": null, "sour