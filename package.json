{
  "name": "cayla-retail",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test",
    "migraciones:verificar": "node scripts/migraciones/verificar.mjs",
    "datos:generar": "node scripts/datos/generar.mjs",
    "datos:generar:produccion": "node scripts/datos/generar.mjs --volcado",
    "datos:comparar": "node scripts/datos/comparar.mjs --md",
    "local:donde": "node scripts/local/donde-estoy.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  }
}
