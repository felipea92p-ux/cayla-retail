{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
