# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# La plantilla sí se versiona (va sin valores). Debe ir al final: en git
# gana la última regla que coincide, y `.env*` de arriba la anularía.
!.env.example

# Responsive Quality Gate: cookies de sesión persistida y capturas/reportes de cada corrida.
# Nunca se versionan — la sesión es un secreto local y la salida se regenera en cada corrida.
responsive/.sesion/
responsive/.salida/
# Auditoría del modo oscuro (ADR-0336): sesiones de las cuentas locales y capturas. Se regeneran en cada corrida.
tema/.sesion/
tema/.salida/
# /unificar: censo, capturas y lámina (se regeneran; lo que se decide queda en docs/unificar/)
unificar/.salida/
